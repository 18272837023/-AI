# ── 服务端配置（复制为 .env 后按需修改）──

# 监听
PORT=5310
HOST=127.0.0.1

# 数据目录
DATA_DIR=data
UPLOAD_DIR=data/uploads

# 文件上限（MB）
MAX_FILE_MB=50

# 任务队列并发数
QUEUE_CONCURRENCY=2

# ── 大模型 ──
# mock = 不调模型，走规则基线（默认，零配置可跑）
# live = 调用 OpenAI 兼容接口
LLM_MODE=mock

# live 模式需要填这三项
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# Linux PDF 字体目录，包含 FandolSong/Hei/Fang-Regular.otf；Windows 默认使用系统字体
# PDF_FONT_DIR=/usr/local/share/fonts/fandol
# 可分别指定字体文件；TTC 集合还需配置对应的 _FAMILY
# PDF_FONT_SONG=/path/to/font.otf
# PDF_FONT_SONG_FAMILY=字体集合中的名称
