# 实际文件放在服务器 /etc/ai-tender/server.env，不放入源码目录
HOST=127.0.0.1
PORT=5310
DATA_DIR=/var/lib/ai-tender
UPLOAD_DIR=/var/lib/ai-tender/uploads
QUEUE_CONCURRENCY=1
MAX_FILE_MB=50
LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
PDF_FONT_DIR=/usr/local/share/fonts/fandol
