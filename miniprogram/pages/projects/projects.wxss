.filters {
  display: flex;
  gap: 16rpx;
  padding: 28rpx 36rpx 0;
  overflow-x: auto;
}

.proj {
  display: flex;
  gap: 24rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 28rpx rgba(29, 33, 41, 0.05);
  margin-bottom: 20rpx;
}

.proj-cover {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.proj-info {
  flex: 1;
  min-width: 0;
}

.proj-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.proj-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.proj-time {
  font-size: 23rpx;
  color: var(--sub);
}

.proj-bar {
  height: 8rpx;
  border-radius: 8rpx;
  background: #F2F4F8;
  margin-top: 18rpx;
  overflow: hidden;
}

.proj-bar-in {
  height: 100%;
  border-radius: 8rpx;
}

.empty {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 28rpx rgba(29, 33, 41, 0.05);
}

.empty-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.empty-d {
  font-size: 23rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-top: 10rpx;
}

.create-entry {
  height: 96rpx;
  border: 2rpx dashed var(--line);
  border-radius: 26rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--sub);
  margin-top: 12rpx;
}
