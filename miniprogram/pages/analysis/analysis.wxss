/* 项目卡 */
.projcard {
  margin: 24rpx 36rpx 0;
  background: linear-gradient(135deg, #1B3A6B, #24497F);
  border-radius: 36rpx;
  padding: 34rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.projcard::after {
  content: "";
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  right: -100rpx;
  top: -120rpx;
}

.pc-name {
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
  margin-bottom: 22rpx;
  position: relative;
  z-index: 2;
}

.pc-grid {
  display: flex;
  flex-wrap: wrap;
  position: relative;
  z-index: 2;
}

.pc-item {
  width: 50%;
  margin-bottom: 18rpx;
}

.pc-item > text:first-child {
  display: block;
  font-size: 21rpx;
  opacity: 0.6;
  margin-bottom: 4rpx;
}

.pc-item .v {
  font-size: 25rpx;
  font-weight: 500;
}

.pc-deadline {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 23rpx;
  position: relative;
  z-index: 2;
}

.pc-deadline .hl {
  color: #FFC53D;
  font-weight: 600;
}

/* Tabs */
.tabs {
  display: flex;
  white-space: nowrap;
  padding: 32rpx 36rpx 0;
  margin-top: 8rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 0; /* 消除 inline-block 之间的空白间隙，避免四个 Tab 横向溢出 */
}

.tabitem {
  display: inline-block;
  font-size: 26rpx;
  color: var(--sub);
  padding-bottom: 20rpx;
  margin-right: 26rpx;
  position: relative;
}

.tabitem.on {
  color: var(--text);
  font-weight: 600;
}

.tabitem.on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 40rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: var(--brand);
}

.tabnum {
  display: inline-block;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  background: var(--red-soft);
  color: var(--red);
  font-size: 19rpx;
  border-radius: 8rpx;
  margin-left: 6rpx;
  padding: 0 4rpx;
}

/* 概况 */
.sect {
  margin-left: 36rpx;
  margin-right: 36rpx;
}

.kv {
  display: flex;
  flex-wrap: wrap;
}

.kv-item {
  width: 50%;
  margin-bottom: 28rpx;
}

.kv-item > text:first-child {
  display: block;
  font-size: 22rpx;
  color: var(--sub);
  margin-bottom: 8rpx;
}

.kv-item .v {
  font-size: 26rpx;
  font-weight: 500;
}

.kv-item .v.brand {
  color: var(--brand);
}

.bul {
  font-size: 25rpx;
  color: var(--sub2);
  line-height: 1.85;
  padding-left: 26rpx;
  position: relative;
  margin-bottom: 14rpx;
}

.bul::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 18rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #C9D2E0;
}

/* 评分 */
.scope-tip {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  margin: 28rpx 36rpx 0;
  padding: 22rpx 24rpx;
  background: #F2F7FF;
  border: 1rpx solid #D8E5FF;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #3B5B95;
}

.scope-ic {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #165DFF;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 32rpx;
  flex: none;
  margin-top: 2rpx;
}

.score-total {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 36rpx 0;
}

.score-box {
  flex: 1;
  border-radius: 24rpx;
  padding: 22rpx 12rpx;
  text-align: center;
}

.sb-num {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.sb-label {
  font-size: 21rpx;
  opacity: 0.8;
}

.sb-scope {
  display: inline-block;
  margin-top: 8rpx;
  padding: 0 10rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 8rpx;
  background: rgba(29, 33, 41, 0.05);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.sbar {
  margin-bottom: 26rpx;
}

.sbar:last-child {
  margin-bottom: 0;
}

.sbar-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sbar-top .name {
  font-size: 25rpx;
  color: var(--sub2);
}

.sbar-top .val {
  font-size: 25rpx;
  color: var(--brand);
  font-weight: 600;
}

.track {
  height: 12rpx;
  border-radius: 8rpx;
  background: #EEF1F7;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #165DFF, #6BA0FF);
}

/* AI 建议 */
.aihint {
  margin: 28rpx 36rpx 0;
  background: linear-gradient(120deg, #FFF8EE, #FFFDF9);
  border: 1rpx solid #FFE4C4;
  border-radius: 26rpx;
  padding: 26rpx 28rpx;
  display: flex;
  gap: 20rpx;
}

.ai-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FF9A2E, #FF7D00);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 700;
  flex: none;
}

.ai-text {
  font-size: 24rpx;
  line-height: 1.75;
  color: #8A5B22;
}

.ai-text .b {
  font-weight: 600;
  color: #6B4416;
}

/* 风险 */
.risk {
  display: flex;
  gap: 22rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.risk:last-child {
  border-bottom: none;
}

.risk-ic {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.risk-ic.high {
  background: var(--red-soft);
  color: var(--red);
}

.risk-ic.mid {
  background: var(--accent-soft);
  color: var(--accent);
}

.risk-body {
  flex: 1;
}

.risk-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.risk-desc {
  font-size: 23rpx;
  color: var(--sub);
  line-height: 1.7;
}

.risk-src {
  font-size: 21rpx;
  color: #A9B0BC;
  margin-top: 10rpx;
}

/* 目录 */
.outline {
  margin: 0 36rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 4rpx 28rpx rgba(29, 33, 41, 0.05);
}

.ol {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ol:last-child {
  border-bottom: none;
}

.ol-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
}

.ol-title .no {
  color: var(--sub);
  font-weight: 400;
  font-size: 25rpx;
  margin-right: 10rpx;
}

.ol-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}

.ol-words {
  font-size: 22rpx;
  color: var(--sub);
}

/* ---------- 合格性审查 ---------- */
.qsum {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 36rpx 0;
}

.qs {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(29, 33, 41, 0.04);
}

.qs .n {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.qs .l {
  font-size: 21rpx;
  color: var(--sub);
}

.q {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.q:last-child {
  border-bottom: none;
}

.q-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.q-code {
  font-size: 22rpx;
  color: var(--sub);
  font-weight: 500;
}

.q-req {
  font-size: 25rpx;
  color: var(--sub2);
  line-height: 1.7;
  margin-top: 12rpx;
}

.q-src {
  font-size: 21rpx;
  color: #A9B0BC;
  margin-top: 10rpx;
}

/* 「需另附材料」：写清由谁在哪儿响应 */
.q-where {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--accent-soft);
  font-size: 22rpx;
  color: #9A5B00;
  line-height: 1.6;
}

.qw-ic {
  flex: none;
  color: var(--accent);
  font-weight: 600;
}

/* ---------- 已识别文件 ---------- */
.file {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.file:last-child {
  border-bottom: none;
}

.file-tag {
  flex: none;
  font-size: 19rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  line-height: 1.3;
}

.file-tag.blue {
  background: var(--brand-soft);
  color: var(--brand);
}

.file-tag.orange {
  background: var(--accent-soft);
  color: var(--accent);
}

.file-body {
  flex: 1;
  min-width: 0;
}

.file-name {
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
}

.file-size {
  font-size: 21rpx;
  color: var(--sub);
  margin-top: 4rpx;
}

/* ---------- 评分项 ---------- */
.sc {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sc:last-child {
  border-bottom: none;
}

.sc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sc-name {
  font-size: 27rpx;
  font-weight: 600;
}

.sc-score {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
}

.sc-tier {
  font-size: 22rpx;
  color: var(--sub);
  line-height: 1.7;
  margin-top: 10rpx;
  background: #F7F9FC;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
}

.sc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.sc-el {
  font-size: 21rpx;
  color: var(--brand);
}

.sc-src {
  font-size: 21rpx;
  color: #A9B0BC;
}

/* ---------- 大纲模式 ---------- */
.mode {
  margin: 28rpx 36rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 28rpx rgba(29, 33, 41, 0.05);
  border-left: 6rpx solid var(--brand);
}

.mode-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mode-tag {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
}

.mode-conf {
  font-size: 20rpx;
  color: var(--sub);
  background: #F2F3F5;
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
}

.mode-quote {
  font-size: 23rpx;
  color: var(--sub2);
  line-height: 1.75;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #F7F9FC;
  border-radius: 16rpx;
}

.mode-src {
  font-size: 21rpx;
  color: #A9B0BC;
  margin-top: 12rpx;
}

.mode-warn {
  font-size: 22rpx;
  color: #C4342F;
  line-height: 1.7;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
}

.lock {
  flex: none;
  font-size: 19rpx;
  color: var(--sub);
  background: #F2F3F5;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
  margin-top: 4rpx;
}
