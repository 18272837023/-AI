<import src="/components/flowbar.wxml" />
<view class="page">
  <template is="flowbar" data="{{step: 3}}" />

  <view class="hero" wx:if="{{loading}}">
    <view class="hero-t">正在准备完整要素表</view>
    <view class="hero-d">{{jobLabel}}</view><view class="hero-t">{{jobProgress}}%</view>
    <view class="hero-d">首次生成需要等待模型逐项填写。你可以返回，稍后重新打开会继续查看同一任务。</view>
  </view>
  <view class="hero" wx:if="{{loadError}}"><view class="hero-t">要素表尚未准备好</view><view class="hero-d">{{loadError}}</view><button class="btn ghost" disabled="{{busy}}" bindtap="retry">重新尝试</button></view>
  <!-- 概览 -->
  <view class="hero" wx:if="{{ready}}">
    <view class="hero-t">{{stats.groups}} 组要素待核对</view>
    <view class="hero-d">核对各评分项的做法、参数、岗位和频次。保存修改后会重新生成正文，请在编辑正文前完成要素填写。</view>
    <view class="hero-stats">
      <view class="hs"><text class="n">{{totalFields}}</text><text class="l">字段</text></view>
      <view class="hs"><text class="n brand">{{filledCount}}</text><text class="l">已填</text></view>
      <view class="hs" bindtap="togglePending"><text class="n">{{pendingCount}}</text><text class="l">待确认 · 点此筛选</text></view>
    </view>
  </view>

  <view class="tools" wx:if="{{ready}}">
    <text class="tool" bindtap="togglePending">{{onlyPending ? '显示全部要素' : '只看待确认'}}</text>
    <text class="tool" bindtap="restore">重新载入已保存内容</text>
    <text class="tool-dot">·</text>
    <text class="tool" bindtap="clearAll">清空重填</text>
  </view>

  <view class="pending-panel" wx:if="{{ready && pendingCount}}">
    <view class="grp-name">待确认字段 · 点名称定位</view>
    <text class="pending-link" wx:for="{{pendingLinks}}" wx:key="anchor" data-anchor="{{item.anchor}}" bindtap="locatePending">{{item.label}}</text>
  </view>
  <view class="pending-panel" wx:if="{{ready && facts.length}}">
    <view class="grp-name">正文中的真实资料待确认（{{facts.length}}项）</view>
    <view class="grp-hint">包括正文和表格内的待确认资料。填入真实值后，点击底部保存，会同步替换对应标记并更新自检。业绩、入场和培训资料也可到待补字段集中填写。</view>
    <text class="tool" bindtap="goFill">前往待补字段 →</text>
    <view class="fd pending-field" wx:for="{{facts}}" wx:key="id">
      <view class="fd-lb">{{item.marker}}</view><view class="grp-hint">所在章节：{{item.chapterText}}</view>
      <textarea class="fd-in fd-area" auto-height maxlength="6000" value="{{item.value}}" placeholder="请填写真实资料" data-id="{{item.id}}" bindinput="onFactInput" />
    </view>
  </view>
  <view class="note" wx:if="{{ready && onlyPending && !pendingCount && !facts.length}}">当前没有待确认字段，可切换显示全部要素。</view>

  <!-- 分组 -->
  <view class="grp" wx:if="{{ready && (!onlyPending || grp.visiblePendingCount)}}" wx:for="{{groups}}" wx:for-item="grp" wx:key="id">
    <view class="grp-hd">
      <view class="grp-l">
        <text class="grp-el">{{grp.el}}</text>
        <text class="grp-name">{{grp.name}}</text>
      </view>
      <text
        wx:if="{{grp.canDeclare}}"
        class="declare {{grp.declared ? 'on' : ''}}"
        data-id="{{grp.id}}"
        bindtap="declare"
      >{{grp.declared ? '已声明缺失' : '确认无此项'}}</text>
      <text wx:else class="must">必填</text>
    </view>
    <view class="grp-ch" wx:if="{{grp.chapter && grp.chapter !== grp.name}}">{{grp.chapter}}</view>

    <block wx:if="{{!grp.declared}}">
      <view
        class="ent {{grp.repeat ? 'is-rep' : ''}}"
        wx:for="{{grp.entries}}"
        wx:for-item="ent"
        wx:for-index="ei"
        wx:key="id"
        wx:if="{{!onlyPending || ent.visiblePendingCount}}"
      >
        <view class="ent-hd" wx:if="{{!grp.repeat}}"><text class="ent-no">{{ent.elementId}} · {{ent.name}}</text></view>
        <view class="ent-hd" wx:if="{{grp.repeat}}">
          <text class="ent-no">{{grp.unit}} {{ei + 1}}</text>
          <text
            wx:if="{{grp.entries.length > 1}}"
            class="ent-del"
            data-g="{{grp.id}}"
            data-e="{{ent.id}}"
            bindtap="removeEntry"
          >删除</text>
        </view>

        <block wx:for="{{ent.fields}}" wx:for-item="f" wx:key="key">
          <view class="fd-sec" wx:if="{{f.type === 'label'}}">{{f.text}}</view>

          <view class="fd" wx:elif="{{f.type === 'chips'}}">
            <view class="fd-lb">{{f.label}}</view>
            <view class="opts">
              <text
                class="opt {{f.value === o ? 'on' : ''}}"
                wx:for="{{f.options}}"
                wx:for-item="o"
                wx:key="*this"
                data-g="{{grp.id}}"
                data-e="{{ent.id}}"
                data-k="{{f.key}}"
                data-v="{{o}}"
                bindtap="pick"
              >{{o}}</text>
            </view>
          </view>

          <view class="fd {{f.pending ? 'pending-field' : ''}}" id="{{f.anchor}}" wx:elif="{{!onlyPending || f.pending || f.keepVisible}}">
            <view class="fd-lb">{{f.label}} {{f.pending ? '· 待确认' : ''}}</view>
            <textarea
              wx:if="{{f.value && f.value.length > 16}}"
              class="fd-in fd-area"
              maxlength="6000"
              auto-height
              value="{{f.value}}"
              placeholder="{{f.ph}}"
              placeholder-class="ph"
              data-g="{{grp.id}}"
              data-e="{{ent.id}}"
              data-k="{{f.key}}"
              bindinput="onInput"
            />
            <input
              wx:else
              class="fd-in"
              maxlength="6000"
              value="{{f.value}}"
              placeholder="{{f.ph}}"
              placeholder-class="ph"
              data-g="{{grp.id}}"
              data-e="{{ent.id}}"
              data-k="{{f.key}}"
              bindinput="onInput"
            />
          </view>
        </block>
      </view>

      <view
        class="add"
        wx:if="{{grp.repeat && grp.entries.length < grp.max}}"
        data-id="{{grp.id}}"
        bindtap="addEntry"
      >＋ 再加一个{{grp.unit}}（最多 {{grp.max}} 个）</view>

      <view
        class="polish {{grp.busy ? 'busy' : ''}}"
        wx:if="{{grp.aiPolish}}"
        data-id="{{grp.id}}"
        bindtap="polish"
      >
        <text class="polish-ic">✦</text>
        <view class="polish-tx">
          <view class="polish-t">{{grp.busy ? 'AI 正在按本项目拆分培训维度…' : 'AI 润色：自动拆 2—6 条'}}</view>
          <view class="polish-d">按项目类型 + 已生成正文拆分培训维度，生成后可自行增删改</view>
        </view>
      </view>

      <view class="grp-hint">{{grp.hint}}</view>
    </block>

    <view class="grp-off" wx:else>已声明本项目无此项。该项预计不得分，但不阻塞导出。</view>
  </view>

  <view class="note" wx:if="{{ready}}">
    修改要素表会重新生成正文并替换旧稿。未知事实请保留待确认标记，可在导出页下载测试草稿。
  </view>

  <view class="placeholder-bar"></view>

  <view class="bottombar">
    <button class="btn" disabled="{{busy || !ready}}" bindtap="save">{{busy ? '保存及生成中…' : '保存并进入正文'}}</button>
  </view>
</view>
