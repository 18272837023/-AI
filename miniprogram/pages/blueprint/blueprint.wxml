<import src="/components/flowbar.wxml" />
<view class="page">
  <template is="flowbar" data="{{step: 2}}" />

  <!-- 概览 -->
  <view class="hero">
    <view class="hero-t">施工图 · 评分项拆解</view>
    <view class="hero-d">先列出每个评分项必须回答的问题，再生成对应正文。完成进度用于查看撰写情况，内容仍需人工核对。</view>
    <view class="hero-stats">
      <view class="hs"><text class="n">{{stats.items}}</text><text class="l">评分项</text></view>
      <view class="hs"><text class="n">{{stats.elements}}</text><text class="l">必答要素</text></view>
      <view class="hs"><text class="n brand">{{stats.rateLabel}}</text><text class="l">正文完成进度</text></view>
    </view>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view class="tabitem {{tab === 0 ? 'on' : ''}}" data-i="0" bindtap="switchTab">施工图</view>
    <view class="tabitem {{tab === 1 ? 'on' : ''}}" data-i="1" bindtap="switchTab">要素表</view>
  </view>

  <!-- 施工图 -->
  <view wx:if="{{tab === 0}}">
    <view class="si" wx:for="{{items}}" wx:key="id">
      <view class="si-hd" data-id="{{item.id}}" bindtap="toggle">
        <view class="si-l">
          <view class="si-name">{{item.name}}</view>
          <view class="si-meta">
            <text class="tag blue">{{item.scoreText}}</text>
            <text class="si-ch">{{item.chapter}}</text>
            <text class="dep {{item.depend}}">{{item.depText}}</text>
            <text class="si-el {{item.done === item.total ? 'ok' : 'todo'}}">{{item.coverageLabel}}</text>
          </view>
        </view>
        <text class="si-arrow">{{item.open ? '−' : '+'}}</text>
      </view>

      <view class="si-body" wx:if="{{item.open}}">
        <view class="tier">
          <text class="tier-lb">评分档次</text>
          <text class="tier-tx">{{item.tier}}</text>
        </view>

        <view class="el" wx:for="{{item.elements}}" wx:for-item="el" wx:key="id">
          <view class="el-dot {{el.done ? 'ok' : 'todo'}}">{{el.done ? '✓' : '○'}}</view>
          <view class="el-body">
            <view class="el-name">{{el.name}}</view><view class="el-status {{el.done ? 'linked' : 'pending'}}">{{el.statusText}}</view>
            <view class="el-must">{{el.must}}</view>
          </view>
        </view>

        <view class="kw">
          <text class="kw-lb">评分关键词</text>
          <text class="kw-i" wx:for="{{item.keywords}}" wx:for-item="k" wx:key="*this">{{k}}</text>
        </view>
      </view>
    </view>

    <view class="legend">
      <text class="lg todo">待 AI 生成</text><text class="lg fill">用户手动补充</text><text class="lg ok">✓ 已完成</text>
    </view>
    <view class="tip"><text class="tip-ic">i</text><view class="tip-tx">
      <view class="tip-l" wx:if="{{!stats.hasBody}}">下一步：确认施工图，再点击“开始生成正文”。此时“待 AI 生成”是正常状态，不代表出错。</view>
      <view class="tip-l" wx:else>“用户手动补充”表示生成后仍缺少对应内容，请检查并补写。</view>
      <view class="tip-l">“已完成”表示已写入对应内容，具体做法和参数仍需人工核对。</view>
      <view class="tip-l">参数是否确认单独检查：遇到〔待确认〕，请补充真实资料。</view>
    </view></view>
  </view>

  <!-- 要素表 -->
  <view wx:if="{{tab === 1}}">
    <view class="sheet-entry"><button class="btn ghost" disabled="{{busy}}" bindtap="editElements">{{hasElements ? '填写 / 编辑要素表' : '生成要素表并填写'}}</button><view class="sheet-entry-desc">把每条要素填成具体做法、参数、责任岗位和实施频次，供 AI 撰写正文。首次生成会显示实时进度。</view></view>
    <view class="sheet" wx:for="{{sheets}}" wx:for-item="group" wx:key="scoreId">
      <view class="sh-title">{{group.item}}</view>
      <view class="row" wx:for="{{group.rows}}" wx:for-item="r" wx:key="el"><view class="row-hd">{{r.el}} {{r.name}}</view><view class="row-point">{{r.point}}</view><view class="row-params">{{r.params}}</view><view class="row-foot">{{r.owner}} · {{r.freq}}</view></view>
    </view>
    <view class="tip">
      <text class="tip-ic">i</text>
      <text>先核对要素表，再生成正文；未知参数请保留待确认标记。</text>
    </view>
  </view>

  <view class="placeholder-bar"></view>

  <view class="bottombar">
    <button class="btn ghost small" bindtap="regenerate">重新拆解</button>
    <button class="btn" bindtap="confirm">确认施工图</button>
  </view>
</view>
