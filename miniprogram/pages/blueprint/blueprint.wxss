/* 概览 */
.hero {
  margin: 24rpx 36rpx 0;
  background: linear-gradient(135deg, #F2F7FF, #EAF1FF);
  border: 1rpx solid #D8E5FF;
  border-radius: 32rpx;
  padding: 32rpx;
}

.hero-t {
  font-size: 32rpx;
  font-weight: 600;
}

.hero-d {
  font-size: 23rpx;
  color: #3B5B95;
  line-height: 1.7;
  margin-top: 10rpx;
}

.hero-stats {
  display: flex;
  margin-top: 26rpx;
}

.hs {
  flex: 1;
  text-align: center;
}

.hs .n {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hs .n.brand {
  color: var(--brand);
}

.hs .l {
  font-size: 21rpx;
  color: var(--sub);
}

/* Tabs */
.tabs {
  display: flex;
  margin: 32rpx 36rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 0;
}

.tabitem {
  display: inline-block;
  font-size: 27rpx;
  color: var(--sub);
  padding-bottom: 18rpx;
  margin-right: 44rpx;
  position: relative;
}

.tabitem.on {
  color: var(--text);
  font-weight: 600;
}

.tabitem.on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 40rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: var(--brand);
}

/* 评分项卡 */
.si {
  margin: 20rpx 36rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 28rpx rgba(29, 33, 41, 0.05);
}

.si-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.si-l {
  flex: 1;
  min-width: 0;
}

.si-name {
  font-size: 28rpx;
  font-weight: 600;
}

.si-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.si-ch {
  font-size: 22rpx;
  color: var(--sub);
}

.si-el {
  font-size: 22rpx;
}

.si-el.ok {
  color: var(--green);
}

.si-el.todo {
  color: var(--accent);
}

.si-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F2F4F8;
  color: var(--sub2);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-left: 16rpx;
}

.si-body {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.tier {
  background: #F7F9FC;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.tier-lb {
  display: block;
  font-size: 20rpx;
  color: var(--sub);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.tier-tx {
  font-size: 23rpx;
  color: var(--sub2);
  line-height: 1.7;
}

.el {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
}

.el-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  font-weight: 600;
}

.el-dot.ok {
  background: var(--green-soft);
  color: var(--green);
}

.el-dot.todo {
  background: var(--accent-soft);
  color: var(--accent);
}

.el-dot.fill {
  background: var(--brand-soft);
  color: var(--brand);
}

/* 依赖等级 */
.dep {
  font-size: 20rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
}

.dep.auto {
  background: var(--green-soft);
  color: var(--green);
}

.dep.mixed {
  background: var(--accent-soft);
  color: var(--accent);
}

.dep.company {
  background: var(--brand-soft);
  color: var(--brand);
}

/* 图例 */
.legend {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 26rpx 36rpx 0;
}

.lg {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.lg.ok {
  background: var(--green-soft);
  color: var(--green);
}

.lg.todo {
  background: var(--accent-soft);
  color: var(--accent);
}

.lg.fill {
  background: var(--brand-soft);
  color: var(--brand);
}

.el-body {
  flex: 1;
  min-width: 0;
}

.el-name {
  font-size: 25rpx;
  font-weight: 500;
}

.el-must {
  font-size: 22rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-top: 4rpx;
}

.kw {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--line);
}

.kw-lb {
  font-size: 21rpx;
  color: var(--sub);
  margin-right: 4rpx;
}

.kw-i {
  font-size: 21rpx;
  color: #3B5B95;
  background: #F2F7FF;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* 要素表 */
.sheet {
  margin: 24rpx 36rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 28rpx rgba(29, 33, 41, 0.05);
}

.sh-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sh-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.sh-src {
  font-size: 22rpx;
  color: var(--sub);
}

.sh-tier {
  font-size: 22rpx;
  color: var(--sub2);
  line-height: 1.7;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
}

.row {
  margin: 16rpx 36rpx 0;
  background: #fff;
  border-radius: 26rpx;
  padding: 26rpx;
  border-left: 6rpx solid transparent;
  box-shadow: 0 4rpx 24rpx rgba(29, 33, 41, 0.04);
}

.row.need {
  border-left-color: var(--accent);
  background: #FFFDF9;
}

.row-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row-el {
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 600;
}

.row-name {
  font-size: 26rpx;
  font-weight: 600;
  flex: 1;
}

.conf {
  font-size: 19rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  flex: none;
}

.conf.high {
  background: #F2F3F5;
  color: var(--sub);
}

.conf.medium {
  background: var(--accent-soft);
  color: var(--accent);
}

.conf.low {
  background: var(--red-soft);
  color: var(--red);
}

.row-point {
  font-size: 24rpx;
  color: var(--sub2);
  line-height: 1.7;
  margin-top: 14rpx;
}

.row-params {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.row-params .p {
  font-size: 21rpx;
  color: #4E5969;
  background: #F5F7FB;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
}

.row-foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: var(--sub);
  margin-top: 16rpx;
}

.row-foot .dot {
  color: #D5DAE3;
}

/* 提示 */
.tip {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 36rpx 0;
  font-size: 22rpx;
  color: var(--sub);
  line-height: 1.7;
}

.tip-ic {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 1rpx solid #A9B0BC;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin-top: 4rpx;
}

.tip-tx {
  flex: 1;
  min-width: 0;
}

.tip-l {
  margin-bottom: 8rpx;
}

.tip-l:last-child {
  margin-bottom: 0;
}

.tip-k {
  font-weight: 600;
  margin-right: 8rpx;
}

.tip-k.todo {
  color: var(--accent);
}

.tip-k.fill {
  color: var(--brand);
}

.el-status { display: inline-block; font-size: 20rpx; line-height: 1.5; padding: 3rpx 10rpx; border-radius: 6rpx; margin-top: 8rpx; }
.el-status.linked { color: #16834b; background: #e8f8ee; }
.el-status.pending { color: #ad5800; background: #fff3df; }
.si-el { white-space: normal; }

.sheet-entry { padding: 28rpx; }
.sheet-entry .btn { width: 100%; }
.sheet-entry-desc { margin-top: 18rpx; font-size: 23rpx; line-height: 1.7; color: #697586; }
