<view class="page">
  <view class="pad">
    <view class="card">
      <view class="ph-t">技术标测试版</view>
      <view class="ph-d">{{description}}</view>
      <view class="ph-row">
        <text class="ph-k">服务连接</text>
        <text class="ph-v">{{api}}</text>
      </view>
      <view class="ph-row">
        <text class="ph-k">技术标项目</text>
        <text class="ph-v">{{count}}</text>
      </view>
    </view>

    <view class="card ph-gap">
      <view class="ph-t">关于这个版本</view>
      <view class="ph-d">只做技术标（施工组织设计、技术方案、服务方案）。商务标、资格文件、报价需另行编制。</view>
      <view class="ph-d">解析、施工图、要素表、正文生成与自检都在服务端完成；规则自检不通过时不能导出正式稿。</view>
    </view>

    <view wx:if="{{isTemporaryTest}}" class="card ph-gap">
      <view class="ph-t">测试访问验证</view>
      <view class="ph-d">仅清除这台设备记住的访问码，然后返回工作台重新输入。已上传的文件和项目内容会保留。</view>
      <button class="btn ghost ph-btn" bindtap="resetTestAccess">重新输入测试访问码</button>
    </view>
    <button class="btn ghost ph-btn" bindtap="goHome">返回工作台</button>
  </view>
</view>
